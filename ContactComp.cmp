<aura:component controller="ControllerForAll" implements="flexipage:availableForAllPageTypes" access="global">

    <!--attributes-->
    <aura:attribute name="contacts" type="Contact[]"/>
    <aura:attribute name="columns" type="List"/>

    <!--Handler method for component initialization-->
    <!--<aura:handler name="init" value="{!this}" action="{!c.doInit}"/>-->
    <aura:method name="refreshTable" action="{!c.refreshTable}" />

    <!--Account table in UI-->
    <lightning:card title="Contact Table">
        <lightning:datatable
            keyField="Id"
            data="{!v.contacts}"
            columns="{!v.columns}"
            hideCheckboxColumn="true"
        />
    </lightning:card>

</aura:component>